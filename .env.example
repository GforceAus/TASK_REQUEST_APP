# Postgres (same values as backend/.env)
PGHOST=
PGPORT=25060
PGDATABASE=gforce
PGUSER=
PGPASSWORD=

# Session — generate a random 64-char string
SESSION_SECRET=change-me-to-a-random-64-char-string

# SMTP — M365 account used to send emails
SMTP_USER=your-m365-account@example.com
SMTP_PASS=change-me

# Server port
PORT=3000
